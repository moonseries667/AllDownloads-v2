{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alldownloads.invalid/contracts/feedback2.schema.json",
  "title": "Part two domain request and result payloads",
  "$defs": {
    "ScanPayload": {
      "type":"object", "additionalProperties":false,
      "properties":{"schemaVersion":{"const":1},"accountId":{"type":"string","minLength":1},"afterMessageId":{"type":"string","pattern":"^(0|[1-9][0-9]*)$"},"continuation":{"type":["string","null"]}},
      "required":["schemaVersion","accountId","afterMessageId","continuation"]
    },
    "ScanResult": {
      "type":"object", "additionalProperties":false,
      "properties":{"accountId":{"type":"string","minLength":1},"messages":{"type":"array","items":{"$ref":"runner.schema.json#/$defs/TelegramScanMessage"}},"complete":{"type":"boolean"},"scannedThroughMessageId":{"type":"string","pattern":"^(0|[1-9][0-9]*)$"},"continuation":{"type":["string","null"]}},
      "required":["accountId","messages","complete","scannedThroughMessageId","continuation"],
      "allOf":[{"if":{"properties":{"complete":{"const":true}}},"then":{"properties":{"continuation":{"type":"null"}}},"else":{"properties":{"continuation":{"type":"string","minLength":1}}}}]
    },
    "TreePayload": {
      "type":"object", "additionalProperties":false,
      "properties":{"schemaVersion":{"const":1},"accountId":{"type":"string","minLength":1},"parentId":{"type":["string","null"]},"shareId":{"type":["string","null"]}},
      "required":["schemaVersion","accountId","parentId","shareId"]
    },
    "TreeResult": {
      "type":"object", "additionalProperties":false,
      "properties":{"accountId":{"type":"string"},"parentId":{"type":["string","null"]},"shareId":{"type":["string","null"]},"folders":{"type":"array","items":{"$ref":"runner.schema.json#/$defs/QuarkFolder"}},"nodes":{"type":"array","items":{"$ref":"runner.schema.json#/$defs/CloudNode"}},"complete":{"type":"boolean"}},
      "required":["accountId","parentId","folders","nodes","complete"]
    },
    "ShareRequest": {
      "type":"object", "additionalProperties":false,
      "properties":{"accountId":{"type":"string","minLength":1},"entries":{"type":"array","minItems":1,"maxItems":200,"items":{"type":"object","additionalProperties":false,"properties":{"url":{"type":"string","format":"uri"},"targetFolderId":{"type":"string","minLength":1},"targetFolderRevision":{"type":"string","minLength":1}},"required":["url","targetFolderId","targetFolderRevision"]}}},
      "required":["accountId","entries"]
    },
    "TransferPayload": {
      "type":"object", "additionalProperties":false,
      "properties":{"schemaVersion":{"const":1},"shareId":{"type":"string"},"url":{"type":"string","format":"uri"},"targetFolderId":{"type":"string"},"targetFolderRevision":{"type":"string"}},
      "required":["schemaVersion","shareId","url","targetFolderId","targetFolderRevision"]
    },
    "TransferResult": {
      "type":"object", "additionalProperties":false,
      "properties":{"shareId":{"type":"string"},"targetFolderId":{"type":"string"},"targetFolderRevision":{"type":"string"},"nodes":{"type":"array","items":{"$ref":"runner.schema.json#/$defs/CloudNode"}},"complete":{"type":"boolean"}},
      "required":["shareId","targetFolderId","targetFolderRevision","nodes","complete"]
    },
    "FolderListing": {
      "type":"object",
      "properties":{"items":{"type":"array","items":{"$ref":"runner.schema.json#/$defs/QuarkFolder"}},"nextCursor":{"type":["string","null"]},"total":{"type":["integer","null"]},"parent":{"oneOf":[{"$ref":"runner.schema.json#/$defs/QuarkFolder"},{"type":"null"}]},"breadcrumbs":{"type":"array","items":{"$ref":"runner.schema.json#/$defs/QuarkFolder"}},"status":{"enum":["READY","LOADING","NEEDS_ACTION"]},"taskId":{"type":["string","null"]}},
      "required":["items","nextCursor","total","parent","breadcrumbs","status","taskId"]
    }
  }
}
